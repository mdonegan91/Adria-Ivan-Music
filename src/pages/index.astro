---
import Base from '../layouts/Base.astro';
import { formatDate, getFeaturedRelease, getSiteSettings } from '../lib/sanity';

const { artistName, tagline, aboutHtml } = await getSiteSettings();
const release = await getFeaturedRelease();

const date = release.releaseDate
  ? formatDate(release.releaseDate, { month: 'long', day: 'numeric', year: 'numeric' })
  : null;
---

<Base description={`${release.title}, the new album from ${artistName}. ${release.ctaLabel}.`}>
  <section class="wrap hero" aria-labelledby="release-title">
    <figure class="cover">
      {
        release.coverUrl ? (
          <img src={release.coverUrl} alt={release.coverAlt} width="1600" height="1600" fetchpriority="high" />
        ) : (
          <picture>
            <source srcset="/images/album-cover.webp" type="image/webp" />
            <img src="/images/album-cover.jpg" alt={release.coverAlt} width="1600" height="1600" fetchpriority="high" />
          </picture>
        )
      }
    </figure>

    <div class="details">
      <p class="eyebrow">{tagline ?? 'The new album'}</p>
      <h1 id="release-title" class="page-title">{release.title}</h1>
      {date && <p class="date">Out <time datetime={release.releaseDate ?? undefined}>{date}</time></p>}
      {release.description && <p class="description">{release.description}</p>}
      <a class="button" href={release.bandcampUrl} rel="noopener">{release.ctaLabel}</a>
    </div>
  </section>

  {
    aboutHtml && (
      <section id="about" class="about" aria-labelledby="about-title">
        <div class="wrap about-grid">
          <h2 id="about-title" class="section-title">About</h2>
          <div class="prose" set:html={aboutHtml} />
        </div>
      </section>
    )
  }
</Base>

<style>
  .hero {
    display: grid;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    padding-block: clamp(2rem, 6vw, 5rem);
  }

  /* The cover's background matches --paper, so the engraving sits directly on the page */
  .cover { margin: 0; }
  .cover img { width: 100%; }

  .details { text-align: center; }
  .date { margin: 1rem 0 0; font-family: var(--font-serif); font-style: italic; font-size: 1.5rem; }
  .description { margin: 1rem auto 0; max-width: 34ch; }
  .button { margin-top: 2rem; }

  .about {
    border-top: 1px solid var(--rule);
    padding-block: clamp(3rem, 8vw, 6rem);
    scroll-margin-top: 1rem;
  }
  .about-grid { display: grid; gap: 1.5rem; }
  .section-title {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(2.5rem, 6vw, 3.5rem);
    line-height: 1;
  }
  .about .prose { font-size: 1.125rem; }

  @media (min-width: 52rem) {
    .hero { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); }
    .details { text-align: left; }
    .description { margin-inline: 0; }
    .about-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 4rem; }
  }
</style>
