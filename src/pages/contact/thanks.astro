---
import Base from '../../layouts/Base.astro';
---

<Base title="Thanks">
  <div class="wrap page">
    <p class="eyebrow">Message sent</p>
    <h1 class="page-title">Thank you</h1>
    <p class="lede">We’ll get back to you soon.</p>
    <a class="button" href="/">Back home</a>
  </div>
</Base>

<style>
  .page { padding-block: clamp(2.5rem, 7vw, 5rem); }
  .lede { margin: 1.25rem 0 2rem; font-size: 1.125rem; }
</style>
