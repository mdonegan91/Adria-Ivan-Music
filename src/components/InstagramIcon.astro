---
interface Props {
  size?: number;
}
const { size = 20 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <rect x="3" y="3" width="18" height="18" rx="5"></rect>
  <circle cx="12" cy="12" r="4.2"></circle>
  <circle cx="17.4" cy="6.6" r="0.6" fill="currentColor" stroke="none"></circle>
</svg>
