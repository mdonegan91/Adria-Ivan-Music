---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSiteSettings } from '../lib/sanity';

interface Props {
  /** Page name, e.g. "Live". Omit on the home page. */
  title?: string;
  description?: string;
  image?: string;
}

const { artistName } = await getSiteSettings();
const { title, description = `The official site of ${artistName}.`, image = '/images/og.jpg' } = Astro.props;

const fullTitle = title ? `${title} — ${artistName}` : artistName;
const base = Astro.site ?? Astro.url;
const ogImage = new URL(image, base).href;
const canonical = new URL(Astro.url.pathname, base).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6eed7" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
